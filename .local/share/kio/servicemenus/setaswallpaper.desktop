[Desktop Entry]
Type=Service
ServiceTypes=KonqPopupMenu/Plugin
MimeType=image/jpeg;image/png;image/webp;image/bmp;image/avif;image/gif;image/svg+xml;image/x-tga;image/tiff;video/mp4;video/webm;video/x-matroska;video/avi;video/quicktime;
X-KDE-Priority=TopLevel
Actions=SetAsWallpaper;

[Desktop Action SetAsWallpaper]
Name=Set as Wallpaper
Icon=preferences-desktop-wallpaper
Exec=/home/medhansh/.config/quickshell/ii/scripts/colors/switchwall.sh --image %f
